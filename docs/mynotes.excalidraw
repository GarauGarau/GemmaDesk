    {
      "id": "NW0laxilB4ghCqgVYqau6",
      "type": "text",
      "x": 3262.407428553719,
      "y": 2203.1409706336462,
      "width": 800,
      "height": 840,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0s",
