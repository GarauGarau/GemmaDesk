      "boundElements": [],
      "updated": 1793183267922,
      "created": 1793178628388,
      "link": null,
      "locked": false,
      "text": "Le prime coordinate sono quindi allenate a funzionare\nanche da sole; quelle successive possono aggiungere\ndettaglio.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le prime coordinate sono quindi allenate a funzionare anche da sole; quelle successive possono aggiungere dettaglio.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
