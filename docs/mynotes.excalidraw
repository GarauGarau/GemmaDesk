      "boundElements": [],
      "updated": 1793183267922,
      "created": 1793177904192,
      "link": null,
      "locked": false,
      "text": "Se il testo da solo contiene 8.000 token, gli stessi\nmedia non possono essere aggiunti senza ridurlo o\nsegmentarlo.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Se il testo da solo contiene 8.000 token, gli stessi media non possono essere aggiunti senza ridurlo o segmentarlo.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
