    },
    {
      "id": "vMAJ1Fef09qSEj3taNahU",
      "type": "text",
      "x": 6489.375091094206,
      "y": 3771.6651969882914,
      "width": 1098.5634413647094,
      "height": 195.61066046557625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1F",
      "roundness": null,
      "seed": 853360306,
      "version": 266,
      "versionNonce": 1965776558,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793183267922,
      "created": 1793178481738,
      "link": null,
      "locked": false,
      "text": "Con pochi documenti conservare 768 numeri per ciascuno\npesa poco. Con milioni di estratti, il costo si accumula:\nquei numeri occupano memoria e devono essere\nconfrontati a ogni ricerca.",
      "fontSize": 39.12213209311525,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Con pochi documenti conservare 768 numeri per ciascuno pesa poco. Con milioni di estratti, il costo si accumula: quei numeri occupano memoria e devono essere confrontati a ogni ricerca.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "IEHZr9UaDhjjxaxSCGkxg",
      "type": "text",
      "x": 6488.439996239213,
      "y": 4027.649132884872,
      "width": 1050.4279735539033,
      "height": 148.89212059831067,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1I",
      "roundness": null,
      "seed": 1601897326,
      "version": 351,
      "versionNonce": 434591982,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793183267922,
      "created": 1793178530199,
      "link": null,
      "locked": false,
      "text": "Gli abbinamenti pertinenti devono essere riconoscibili\nusando l’intero vettore, ma anche usando soltanto le\nprime 128, 256 o 512 coordinate",
      "fontSize": 39.70456549288284,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Gli abbinamenti pertinenti devono essere riconoscibili usando l’intero vettore, ma anche usando soltanto le prime 128, 256 o 512 coordinate",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
