    {
      "id": "zGQib4cv-BhOEHqNf-YMs",
      "type": "text",
      "x": 6691.685924676511,
      "y": 4275.009908616483,
      "width": 736.125,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
